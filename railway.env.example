# Copy these into Railway → your service → Variables
# https://docs.railway.com/guides/variables

# Required for AI features (or set later in the app Settings UI)
LLM_PROVIDER=openai
LLM_API_KEY=

# Optional overrides
# LLM_MODEL=gpt-4o-mini
# LOG_LEVEL=INFO

# FRONTEND_BASE_URL is auto-set from RAILWAY_PUBLIC_DOMAIN when unset.
# Set explicitly if you use a custom domain:
# FRONTEND_BASE_URL=https://your-custom-domain.com
